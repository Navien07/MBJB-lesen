# Supabase — from `supabase projects api-keys` / dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never exposed to the client; used by the worker and seed scripts.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres password for the linked remote project (supabase link / db push)
SUPABASE_DB_PASSWORD=

# Anthropic — runtime calls made by the product itself, not by Claude Code
ANTHROPIC_API_KEY=

# AI gateway behaviour: live | replay. Tests and CI run replay; only the
# production pipeline and the @live smoke test run live.
AI_GATEWAY_MODE=replay

# Model split per agent (see CLAUDE.md "Runtime model choice"). Env-tunable
# so the split can change without a deploy.
AI_MODEL_INTAKE=claude-sonnet-4-6
AI_MODEL_SIGNBOARD=claude-opus-4-8
AI_MODEL_COPILOT=claude-sonnet-4-6

# E2E target override; unset means the Playwright webServer default
PLAYWRIGHT_BASE_URL=
